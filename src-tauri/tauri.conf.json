{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floria SelfHub",
  "version": "1.4.1",
  "identifier": "dev.selfhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Floria SelfHub",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "files": {
          "linux/dev.selfhub.app.desktop": "/usr/share/applications/dev.selfhub.app.desktop",
          "icons/floria-selfhub/icon.png": "/usr/share/icons/hicolor/512x512/apps/floria-selfhub.png"
        }
      },
      "rpm": {
        "files": {
          "linux/dev.selfhub.app.desktop": "/usr/share/applications/dev.selfhub.app.desktop",
          "icons/floria-selfhub/icon.png": "/usr/share/icons/hicolor/512x512/apps/floria-selfhub.png"
        }
      }
    },
    "icon": [
      "icons/floria-selfhub/floria-selfhub-32.png",
      "icons/floria-selfhub/floria-selfhub-128.png",
      "icons/floria-selfhub/floria-selfhub-256.png",
      "icons/floria-selfhub/icon.png",
      "icons/floria-selfhub/floria-selfhub.icns",
      "icons/floria-selfhub/floria-selfhub.ico"
    ]
  }
}