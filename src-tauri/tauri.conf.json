{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SelfHub",
  "version": "1.1.0",
  "identifier": "dev.selfhub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SelfHub",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/selfhub/selfhub-32.png",
      "icons/selfhub/selfhub-128.png",
      "icons/selfhub/selfhub-256.png",
      "icons/selfhub/selfhub.icns",
      "icons/selfhub/selfhub.ico"
    ]
  }
}